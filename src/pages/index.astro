---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');

// Helper to get unique sorted values from recipes
const getUniqueValues = (getter: (r: typeof recipes[number]) => string | undefined): string[] => {
  return [
    ...new Set(
      recipes
        .map(getter)
        .filter((v): v is string => Boolean(v))
    ),
  ].sort();
};

const categories = getUniqueValues((r) => r.data.category);
const difficulties = getUniqueValues((r) => r.data.difficulty);
const cuisines = getUniqueValues((r) => r.data.cuisine);
const seasons = getUniqueValues((r) => r.data.season);
const tags = [...new Set(recipes.flatMap((r) => r.data.tags))].sort();

// Label mappings (no icons)
const categoryLabels: Record<string, string> = {
  antipasto: 'Antipasti',
  primo: 'Primi',
  secondo: 'Secondi',
  contorno: 'Contorni',
  dolce: 'Dolci',
  bibita: 'Bibite',
  'salse/basi': 'Salse e Basi',
  'piatto unico': 'Piatto Unico',
};

const difficultyLabels: Record<string, string> = {
  facile: 'Facile',
  media: 'Media',
  difficile: 'Difficile',
};

const cuisineLabels: Record<string, string> = {
  italiana: 'Italiana',
  colombiana: 'Colombiana',
  messicana: 'Messicana',
  giapponese: 'Giapponese',
  francese: 'Francese',
  mediterranea: 'Mediterranea',
  altro: 'Altro',
};

const seasonLabels: Record<string, string> = {
  primavera: 'Primavera',
  estate: 'Estate',
  autunno: 'Autunno',
  inverno: 'Inverno',
  "tutto l'anno": "Tutto l'anno",
};
---

<Layout title="Le Nostre Ricette">
  <section class="hero">
    <div class="hero__badge">
      <span>Ricettario di Casa</span>
      <span class="hero__badge-dot">·</span>
      <span>{recipes.length} {recipes.length === 1 ? 'ricetta' : 'ricette'}</span>
    </div>

    <h1 class="hero__title">Cosa cuciniamo oggi?</h1>

    <p class="hero__description">
      Tutti i nostri piatti del cuore, collaudati e trascritti per essere rifatti ogni volta che vogliamo.
    </p>
  </section>

  <section class="recipe-browser" aria-label="Cerca e filtra le ricette">
    <!-- Search Bar with Filter Button -->
    <div class="search-container">
      <div class="search-box">
        <span class="search-icon" aria-hidden="true">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          id="search"
          class="search-input"
          type="search"
          placeholder="Cerca per titolo, ingrediente o tag..."
          aria-label="Cerca una ricetta"
          autocomplete="off"
        />
        <button
          id="filter-toggle"
          class="filter-toggle"
          type="button"
          aria-label="Apri filtri"
          aria-expanded="false"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="7" y1="12" x2="17" y2="12"></line>
            <line x1="10" y1="18" x2="14" y2="18"></line>
          </svg>
          <span class="filter-toggle__badge hidden" id="filter-badge"></span>
        </button>
        <button
          id="clear-search"
          class="search-clear hidden"
          type="button"
          aria-label="Cancella testo di ricerca"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Active filters summary (always visible) -->
    <div id="filter-status" class="filter-status hidden">
      <span id="filter-status-text" class="filter-status__text"></span>
      <button id="reset-filters" class="filter-status__reset" type="button">
        Azzera filtri
      </button>
    </div>

    <!-- Recipe Carousels -->
    <div id="recipe-grid" class="recipe-carousels">
      {categories.map((category) => {
        const categoryRecipes = recipes.filter((r) => r.data.category === category);
        if (categoryRecipes.length === 0) return null;
        return (
          <div class="carousel-section" data-category={category}>
            <h2 class="carousel-section__title">{categoryLabels[category] || category}</h2>
            <div class="carousel">
              {categoryRecipes.map((recipe) => (
                <div
                  class="recipe-wrapper"
                  data-title={recipe.data.title.toLowerCase()}
                  data-description={recipe.data.description?.toLowerCase() ?? ''}
                  data-category={recipe.data.category}
                  data-tags={recipe.data.tags.join('|')}
                  data-ingredients={[...recipe.data.ingredients, ...recipe.data.variants.flatMap(v => v.ingredients)].map(i => i.item.toLowerCase()).join(' ')}
                  data-difficulty={recipe.data.difficulty ?? ''}
                  data-cuisine={recipe.data.cuisine ?? ''}
                  data-season={recipe.data.season ?? ''}
                >
                  <RecipeCard
                    slug={recipe.id}
                    title={recipe.data.title}
                    category={recipe.data.category}
                    image={recipe.data.image}
                  />
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-results" class="no-results hidden">
      <h2 class="no-results__title">Nessuna ricetta trovata</h2>
      <p class="no-results__text">
        Non abbiamo trovato ricette che corrispondono ai filtri o alla ricerca selezionata.
      </p>
      <button id="reset-no-results" class="no-results__reset" type="button">
        Reimposta filtri
      </button>
    </div>
  </section>

  <!-- Filter Modal -->
  <div id="filter-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="filter-modal-title">
    <div class="modal__backdrop" id="modal-backdrop"></div>
    <div class="modal__content">
      <div class="modal__header">
        <h2 id="filter-modal-title" class="modal__title">Filtri</h2>
        <button id="modal-close" class="modal__close" type="button" aria-label="Chiudi filtri">
          ✕
        </button>
      </div>

      <div class="modal__body">
        <!-- Difficulty -->
        {difficulties.length > 0 && (
          <div class="filter-section">
            <span class="filter-section__label">Difficoltà</span>
            <div class="filter-chips">
              <button
                class="filter-chip filter-chip--difficulty active"
                data-difficulty="all"
                type="button"
              >
                Tutte
              </button>
              {difficulties.map((d) => (
                <button
                  class="filter-chip filter-chip--difficulty"
                  data-difficulty={d}
                  type="button"
                >
                  {difficultyLabels[d] || d}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Cuisine -->
        {cuisines.length > 0 && (
          <div class="filter-section">
            <span class="filter-section__label">Cucina</span>
            <div class="filter-chips">
              <button
                class="filter-chip filter-chip--cuisine active"
                data-cuisine="all"
                type="button"
              >
                Tutte
              </button>
              {cuisines.map((c) => (
                <button
                  class="filter-chip filter-chip--cuisine"
                  data-cuisine={c}
                  type="button"
                >
                  {cuisineLabels[c] || c}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Season -->
        {seasons.length > 0 && (
          <div class="filter-section">
            <span class="filter-section__label">Stagione</span>
            <div class="filter-chips">
              <button
                class="filter-chip filter-chip--season active"
                data-season="all"
                type="button"
              >
                Tutte
              </button>
              {seasons.map((s) => (
                <button
                  class="filter-chip filter-chip--season"
                  data-season={s}
                  type="button"
                >
                  {seasonLabels[s] || s}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="filter-section">
            <span class="filter-section__label">Tag</span>
            <div class="filter-chips">
              {tags.map((t) => (
                <button
                  class="filter-chip filter-chip--tag"
                  data-tag={t}
                  type="button"
                >
                  #{t}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="modal__footer">
        <button id="modal-reset" class="modal__reset" type="button">
          Azzera tutto
        </button>
        <button id="modal-apply" class="modal__apply" type="button">
          Mostra ricette
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#search');
  const clearSearchBtn = document.querySelector<HTMLButtonElement>('#clear-search');
  const filterToggle = document.querySelector<HTMLButtonElement>('#filter-toggle');
  const filterBadge = document.querySelector<HTMLElement>('#filter-badge');
  const recipeWrappers = document.querySelectorAll<HTMLElement>('.recipe-wrapper');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const resetFiltersBtn = document.querySelector<HTMLButtonElement>('#reset-filters');
  const resetNoResultsBtn = document.querySelector<HTMLButtonElement>('#reset-no-results');
  const filterStatus = document.querySelector<HTMLElement>('#filter-status');
  const filterStatusText = document.querySelector<HTMLElement>('#filter-status-text');

  // Modal elements
  const modal = document.querySelector<HTMLElement>('#filter-modal');
  const modalBackdrop = document.querySelector<HTMLElement>('#modal-backdrop');
  const modalClose = document.querySelector<HTMLButtonElement>('#modal-close');
  const modalReset = document.querySelector<HTMLButtonElement>('#modal-reset');
  const modalApply = document.querySelector<HTMLButtonElement>('#modal-apply');

  // Filter chips
  const categoryChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip--category');
  const difficultyChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip--difficulty');
  const cuisineChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip--cuisine');
  const seasonChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip--season');
  const tagChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip--tag');

  const totalRecipesCount = recipeWrappers.length;
  let selectedCategory = 'all';
  let selectedDifficulty = 'all';
  let selectedCuisine = 'all';
  let selectedSeason = 'all';
  let selectedTag: string | null = null;

  function updateRecipes() {
    const search = searchInput?.value.toLowerCase().trim() ?? '';

    if (clearSearchBtn) {
      clearSearchBtn.classList.toggle('hidden', search.length === 0);
    }

    let visibleCount = 0;

    recipeWrappers.forEach((recipe) => {
      const title = recipe.getAttribute('data-title') ?? '';
      const description = recipe.getAttribute('data-description') ?? '';
      const category = recipe.getAttribute('data-category') ?? '';
      const tags = recipe.getAttribute('data-tags') ?? '';
      const ingredients = recipe.getAttribute('data-ingredients') ?? '';
      const difficulty = recipe.getAttribute('data-difficulty') ?? '';
      const cuisine = recipe.getAttribute('data-cuisine') ?? '';
      const season = recipe.getAttribute('data-season') ?? '';

      const matchesSearch =
        !search ||
        title.includes(search) ||
        description.includes(search) ||
        tags.toLowerCase().includes(search) ||
        ingredients.includes(search);

      const matchesCategory =
        selectedCategory === 'all' || category === selectedCategory;

      const matchesDifficulty =
        selectedDifficulty === 'all' || difficulty === selectedDifficulty;

      const matchesCuisine =
        selectedCuisine === 'all' || cuisine === selectedCuisine;

      const matchesSeason =
        selectedSeason === 'all' || season === selectedSeason;

      const matchesTag =
        !selectedTag || tags.split('|').includes(selectedTag);

      const visible = matchesSearch && matchesCategory && matchesDifficulty && matchesCuisine && matchesSeason && matchesTag;

      recipe.classList.toggle('hidden', !visible);

      if (visible) {
        visibleCount++;
      }
    });

    noResults?.classList.toggle('hidden', visibleCount > 0);

    // Update filter status bar
    const activeFiltersCount = [
      selectedCategory !== 'all',
      selectedDifficulty !== 'all',
      selectedCuisine !== 'all',
      selectedSeason !== 'all',
      selectedTag !== null,
    ].filter(Boolean).length;

    const hasActiveFilters = Boolean(search || activeFiltersCount > 0);

    if (filterStatus && filterStatusText) {
      filterStatus.classList.toggle('hidden', !hasActiveFilters);
      if (hasActiveFilters) {
        filterStatusText.textContent = `Mostrando ${visibleCount} di ${totalRecipesCount} ricette`;
      }
    }

    // Update filter badge
    if (filterBadge) {
      filterBadge.textContent = String(activeFiltersCount);
      filterBadge.classList.toggle('hidden', activeFiltersCount === 0);
    }
  }

  function resetAll() {
    if (searchInput) {
      searchInput.value = '';
    }
    selectedCategory = 'all';
    selectedDifficulty = 'all';
    selectedCuisine = 'all';
    selectedSeason = 'all';
    selectedTag = null;

    categoryChips.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-category') === 'all');
    });

    difficultyChips.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-difficulty') === 'all');
    });

    cuisineChips.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-cuisine') === 'all');
    });

    seasonChips.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-season') === 'all');
    });

    tagChips.forEach((btn) => {
      btn.classList.remove('active');
    });

    updateRecipes();
  }

  // Modal functions
  function openModal() {
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      filterToggle?.setAttribute('aria-expanded', 'true');
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      filterToggle?.setAttribute('aria-expanded', 'false');
    }
  }

  // Keyboard shortcut: '/' focuses search input
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      const activeTag = document.activeElement?.tagName.toLowerCase();
      if (activeTag !== 'input' && activeTag !== 'textarea' && activeTag !== 'select') {
        e.preventDefault();
        searchInput?.focus();
      }
    }
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  searchInput?.addEventListener('input', updateRecipes);

  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      updateRecipes();
    }
  });

  resetFiltersBtn?.addEventListener('click', resetAll);
  resetNoResultsBtn?.addEventListener('click', resetAll);

  // Modal events
  filterToggle?.addEventListener('click', openModal);
  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalApply?.addEventListener('click', closeModal);
  modalReset?.addEventListener('click', resetAll);

  // Filter chip events
  categoryChips.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category') ?? 'all';
      selectedCategory = category;

      categoryChips.forEach((b) => b.classList.remove('active'));
      button.classList.add('active');

      updateRecipes();
    });
  });

  difficultyChips.forEach((button) => {
    button.addEventListener('click', () => {
      const difficulty = button.getAttribute('data-difficulty') ?? 'all';
      selectedDifficulty = difficulty;

      difficultyChips.forEach((b) => b.classList.remove('active'));
      button.classList.add('active');

      updateRecipes();
    });
  });

  cuisineChips.forEach((button) => {
    button.addEventListener('click', () => {
      const cuisine = button.getAttribute('data-cuisine') ?? 'all';
      selectedCuisine = cuisine;

      cuisineChips.forEach((b) => b.classList.remove('active'));
      button.classList.add('active');

      updateRecipes();
    });
  });

  seasonChips.forEach((button) => {
    button.addEventListener('click', () => {
      const season = button.getAttribute('data-season') ?? 'all';
      selectedSeason = season;

      seasonChips.forEach((b) => b.classList.remove('active'));
      button.classList.add('active');

      updateRecipes();
    });
  });

  tagChips.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      selectedTag = selectedTag === tag ? null : tag;

      tagChips.forEach((b) => b.classList.remove('active'));
      if (selectedTag) {
        button.classList.add('active');
      }

      updateRecipes();
    });
  });
</script>
