---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Our Recipes' } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Il nostro ricettario personale."
    />

    <title>{title} · Our Recipes</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="site-title">
        🍝 Our Recipes
      </a>

      <nav>
        <a href="/">Ricette</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>Our Recipes ❤️</p>
    </footer>
  </body>
</html>