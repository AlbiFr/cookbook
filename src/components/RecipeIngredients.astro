---
interface Ingredient {
  quantity?: number;
  unit?: string;
  item: string;
}

interface IngredientGroup {
  name: string;
  items: Ingredient[];
}

interface Variant {
  name: string;
  description?: string;
  ingredients: Ingredient[];
}

interface Props {
  title: string;
  ingredients: Ingredient[];
  servings: number;
  variants?: Variant[];
}

const { title, ingredients, servings, variants = [] } = Astro.props;

const allVariants = [
  { name: 'Originale', description: undefined, ingredients },
  ...variants,
];

const hasVariants = variants.length > 0;

function capitalize(str: string): string {
  return str.charAt(0).toUpperCase() + str.slice(1);
}

function formatIngredientQuantity(ingredient: Ingredient): string {
  if (ingredient.unit === 'qb') return 'q.b.';
  const qty = ingredient.quantity ?? '';
  const unit = ingredient.unit ? ` ${ingredient.unit}` : '';
  return `${qty}${unit}`;
}

// Lo schema accetta due forme: la voce singola (ricette senza divisori) e il
// gruppo `{ name, items }`. Qui le due forme diventano la stessa struttura, con
// la lista piatta come un unico gruppo senza nome: da qui in poi la pagina e la
// copia della lista non devono più distinguere i due casi.
function toGroups(entries: (Ingredient | IngredientGroup)[]): IngredientGroup[] {
  const groups: IngredientGroup[] = [];

  for (const entry of entries) {
    if ('items' in entry) {
      if (entry.items.length > 0) groups.push(entry);
      continue;
    }

    const previous = groups[groups.length - 1];
    if (previous && !previous.name) previous.items.push(entry);
    else groups.push({ name: '', items: [entry] });
  }

  return groups;
}
---

<section class="recipe-ingredients" aria-labelledby="ingredients-heading">
  <div class="recipe-ingredients__header">
    <h2 id="ingredients-heading" class="recipe-ingredients__title">Ingredienti</h2>
  </div>

  <div class="servings-control">
    <span class="servings-control__label">Porzioni</span>
    <div class="servings-control__box">
      <button
        id="decrease-servings"
        type="button"
        aria-label="Riduci porzioni"
        class="servings-control__btn"
      >
        −
      </button>
      <span id="servings-value" class="servings-control__value">{servings}</span>
      <button
        id="increase-servings"
        type="button"
        aria-label="Aumenta porzioni"
        class="servings-control__btn"
      >
        +
      </button>
    </div>
  </div>

  {hasVariants && (
    <div class="variant-switcher" role="tablist" aria-label="Varianti della ricetta">
      {allVariants.map((variant, index) => (
        <button
          type="button"
          class={`variant-pill${index === 0 ? ' variant-pill--active' : ''}`}
          data-variant-index={index}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          {variant.name}
        </button>
      ))}
    </div>
  )}

  {allVariants.map((variant, index) => (
    <div
      class={`variant-panel${index === 0 ? ' variant-panel--active' : ''}`}
      data-variant-index={index}
      role="tabpanel"
    >
      {variant.description && (
        <p class="variant-note">{variant.description}</p>
      )}
      {toGroups(variant.ingredients).map((group) => (
        <div class="ingredients-group">
          {group.name && (
            <h3 class="ingredients-group__title">{group.name}</h3>
          )}
          <ul class="ingredients-list">
            {group.items.map((ingredient) => (
              <li
                class="ingredient"
                data-quantity={ingredient.quantity ?? ''}
                data-unit={ingredient.unit ?? ''}
                data-item={ingredient.item}
              >
                <span class="ingredient__text">
                  <span class="ingredient__name">{capitalize(ingredient.item)}</span>
                  <span class="ingredient__quantity">{formatIngredientQuantity(ingredient)}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ))}

  <div class="recipe-ingredients__footer">
    <button id="copy-ingredients" class="copy-button" type="button">
      <span class="copy-button__icon" aria-hidden="true"></span>
      <span class="copy-button__text">Copia lista per la spesa</span>
    </button>
  </div>
</section>

<script define:vars={{ originalServings: servings, recipeTitle: title }}>
  let currentServings = originalServings;

  const servingsValue = document.querySelector('#servings-value');
  const decreaseButton = document.querySelector('#decrease-servings');
  const increaseButton = document.querySelector('#increase-servings');
  const copyButton = document.querySelector('#copy-ingredients');
  const variantPills = document.querySelectorAll('.variant-pill');
  const variantPanels = document.querySelectorAll('.variant-panel');

  function formatQuantity(value) {
    if (Number.isInteger(value)) {
      return value.toString();
    }
    const rounded = Math.round(value * 100) / 100;
    return rounded.toString().replace('.', ',');
  }

  function updateIngredients() {
    if (!servingsValue) return;
    servingsValue.textContent = currentServings;

    const allIngredients = document.querySelectorAll('.ingredient');
    allIngredients.forEach((ingredient) => {
      const quantity = ingredient.getAttribute('data-quantity');
      const unit = ingredient.getAttribute('data-unit') || '';
      const quantityElement = ingredient.querySelector('.ingredient__quantity');
      if (!quantityElement) return;

      // Don't scale "q.b." (quanto basta) ingredients
      if (unit.toLowerCase() === 'qb') {
        quantityElement.textContent = 'q.b.';
        return;
      }

      // Don't scale ingredients without a numeric quantity
      if (!quantity || isNaN(Number(quantity))) {
        quantityElement.textContent = unit ? unit : '';
        return;
      }

      const originalQuantity = Number(quantity);
      const newQuantity = (originalQuantity * currentServings) / originalServings;
      quantityElement.textContent = `${formatQuantity(newQuantity)}${unit ? ` ${unit}` : ''}`;
    });
  }

  function activateVariant(index) {
    variantPills.forEach((pill, i) => {
      pill.classList.toggle('variant-pill--active', i === index);
      pill.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
    variantPanels.forEach((panel, i) => {
      panel.classList.toggle('variant-panel--active', i === index);
    });
  }

  function slugify(name) {
    return name.toLowerCase().trim().replace(/\s+/g, '-');
  }

  variantPills.forEach((pill, index) => {
    pill.addEventListener('click', () => {
      activateVariant(index);
      history.replaceState(null, '', `#${slugify(pill.textContent)}`);
    });
  });

  if (variantPills.length > 0 && window.location.hash) {
    const hash = window.location.hash.slice(1).toLowerCase();
    variantPills.forEach((pill, index) => {
      if (slugify(pill.textContent) === hash) {
        activateVariant(index);
      }
    });
  }

  decreaseButton?.addEventListener('click', () => {
    if (currentServings > 1) {
      currentServings -= 1;
      updateIngredients();
    }
  });

  increaseButton?.addEventListener('click', () => {
    if (currentServings < 50) {
      currentServings += 1;
      updateIngredients();
    }
  });

  copyButton?.addEventListener('click', async () => {
    const activePanel = document.querySelector('.variant-panel--active');
    if (!activePanel) return;

    // Si copia gruppo per gruppo, così il divisore finisce nella lista della
    // spesa. Le ricette senza divisori hanno un solo gruppo senza titolo: il
    // risultato è identico a quello di prima, intestazione e righe vuote in più.
    const blocks = [];

    activePanel.querySelectorAll('.ingredients-group').forEach((group) => {
      const block = [];
      const groupTitle = group.querySelector('.ingredients-group__title')?.textContent?.trim();

      if (groupTitle) block.push(groupTitle.toUpperCase());

      group.querySelectorAll('.ingredient').forEach((item) => {
        const qty = item.querySelector('.ingredient__quantity')?.textContent?.trim() ?? '';
        const name = item.querySelector('.ingredient__name')?.textContent?.trim() ?? '';
        block.push(qty ? `- ${name} — ${qty}` : `- ${name}`);
      });

      if (block.length > 0) blocks.push(block.join('\n'));
    });

    // The panel carries its own index and the pill at the same index holds the
    // variant name, so the heading can name the variant that is actually
    // being copied. Index 0 is the default list, which needs no suffix.
    const variantIndex = Number(activePanel.getAttribute('data-variant-index') ?? '0');
    const variantName = variantPills[variantIndex]?.textContent?.trim();
    const heading =
      variantIndex > 0 && variantName ? `${recipeTitle} (${variantName})` : recipeTitle;

    const portions = currentServings === 1 ? 'persona' : 'persone';
    const textToCopy = `${heading} per ${currentServings} ${portions}:\n\n${blocks.join('\n\n')}`;

    try {
      await navigator.clipboard.writeText(textToCopy);

      if (copyButton) {
        const textSpan = copyButton.querySelector('.copy-button__text');
        const iconSpan = copyButton.querySelector('.copy-button__icon');
        const originalText = textSpan ? textSpan.textContent : '';

        if (textSpan) textSpan.textContent = 'Lista copiata negli appunti!';
        if (iconSpan) iconSpan.textContent = '✓';
        copyButton.classList.add('copy-button--success');

        setTimeout(() => {
          if (textSpan) textSpan.textContent = originalText;
          if (iconSpan) iconSpan.textContent = '';
          copyButton.classList.remove('copy-button--success');
        }, 2200);
      }
    } catch {
      alert('Impossibile copiare gli ingredienti automaticamente.');
    }
  });
</script>
