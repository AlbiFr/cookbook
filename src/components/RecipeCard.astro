---
interface Props {
  slug: string;
  title: string;
  category: string;
  image?: string;
}

const { slug, title, category, image } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const imageUrl = image ? `${baseUrl}${image.replace(/^\/+/, '')}` : undefined;

const categoryIcons: Record<string, string> = {
  antipasto: '🥖',
  primo: '🍝',
  secondo: '🥘',
  contorno: '🥗',
  dolce: '🍰',
  bibita: '🥤',
  'salse/basi': '🫙',
  'piatto unico': '🍽️',
};
---

<a href={`${baseUrl}recipes/${slug}/`} class="recipe-card" data-category={category}>
  <div class="recipe-card__media">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={title}
        class="recipe-card__image"
        loading="lazy"
      />
    ) : (
      <div class="recipe-card__placeholder">
        <span class="recipe-card__placeholder-icon" aria-hidden="true">
          {categoryIcons[category] || '🍽️'}
        </span>
        <span class="recipe-card__placeholder-pattern" aria-hidden="true"></span>
      </div>
    )}
  </div>
  <h2 class="recipe-card__title">{title}</h2>
</a>
